IDC_ORINRINVIEWER MENU
BEGIN
    POPUP "기능(&F)"
    BEGIN
        MENUITEM "프로파일 생성/열기(&N)",	IDM_MAA_PROFILE_MAKE
        MENUITEM "AA 목록 트리 재구성(&T)",	IDM_TREE_RECONSTRUCT
		MENUITEM "프로파일 사용 이력(&H)",	IDM_OPEN_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "일반 설정(&G)",				IDM_GENERAL_OPTION
        MENUITEM "배경색 변경(&K)",				IDM_MAAITEM_BKCOLOUR
        MENUITEM "파일명으로 검색(&F)",		IDM_FINDMAA_DLG_OPEN
        MENUITEM SEPARATOR
        MENUITEM "썸네일 목록 표시(&M)",		IDM_MAA_THUMBNAIL_OPEN
        MENUITEM "드래프트 보드 표시(&B)",		IDM_DRAUGHT_OPEN
        MENUITEM SEPARATOR
        MENUITEM "항상 위에 표시(&A)",			IDM_TOPMOST_TOGGLE
        MENUITEM SEPARATOR
        MENUITEM "버전 정보(&I)",				IDM_ABOUT
        MENUITEM "종료(&Q)",					IDM_EXIT
    END
END

IDM_AATREE_POPUP MENU
BEGIN
    POPUP "다중 행 템플릿 트리의 그것"
    BEGIN
        MENUITEM "파일명으로 검색(&F)",		IDM_FINDMAA_DLG_OPEN
        MENUITEM "드래프트 보드 표시(&B)",		IDM_DRAUGHT_OPEN
        MENUITEM SEPARATOR
        MENUITEM "(선택되지 않음)",				IDM_DUMMY, GRAYED
        MENUITEM "주 탭에서 열기(&M)",			IDM_AATREE_MAINOPEN
        MENUITEM "부 탭 추가(&S)",				IDM_AATREE_SUBADD
        MENUITEM SEPARATOR
        MENUITEM "이 항목 삭제(&D)",			IDM_MAA_ITEM_DELETE, GRAYED
    END
END

IDM_AATABS_POPUP MENU
BEGIN
    POPUP "다중 행 템플릿 탭의 그것"
    BEGIN
        MENUITEM "이 탭 닫기(&Q)",				IDM_AATABS_DELETE
        MENUITEM "모든 부 탭 닫기(&A)",		IDM_AATABS_ALLDELETE
        MENUITEM SEPARATOR
        MENUITEM "표시 이름 변경(&N)",			IDM_AATABS_RENAME
        MENUITEM SEPARATOR
        MENUITEM "부 탭을 한 줄로 표시",		IDM_AATABS_SINGLETAB
    END
END

IDM_AALIST_POPUP MENU
BEGIN
    POPUP "다중 행 템플릿 표시에서의 그것"
    BEGIN
        MENUITEM "드래프트 보드에 추가(&G)",	IDM_DRAUGHT_ADDING
        MENUITEM SEPARATOR
        MENUITEM "복사(UNI&CODE)",			IDM_MAA_CLIP_UNICODE
        MENUITEM "복사(&ShiftJIS)",			IDM_MAA_CLIP_SHIFTJIS
        MENUITEM SEPARATOR
        MENUITEM "삭제(&D)",					IDM_MAA_FAV_DELETE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "드래프트 보드 표시(&B)",		IDM_DRAUGHT_OPEN
        MENUITEM "썸네일 목록 표시(&H)",		IDM_MAA_THUMBNAIL_OPEN
        MENUITEM SEPARATOR
        MENUITEM "AA 팝업 표시(&T)",			IDM_MAA_AATIP_TOGGLE
        MENUITEM "AA 구분 스타일 전환",		IDM_MAA_SEP_STYLE_TOGGLE
    END
END

IDM_DRAUGHT_POPUP MENU
BEGIN
    POPUP "드래프트 보드의 그것"
    BEGIN
        MENUITEM "복사(UNI&CODE)",			IDM_DRAUGHT_UNICLIP
        MENUITEM "복사(Shift&JIS)",			IDM_DRAUGHT_SJISCLIP
        MENUITEM SEPARATOR
        MENUITEM "항목 삭제(&D)",			IDM_DRAUGHT_DELETE
        MENUITEM "모든 내용 삭제(&K)",		IDM_DRAUGHT_ALLDELETE
        MENUITEM SEPARATOR
        POPUP "이미지 크기"
		BEGIN
			MENUITEM "작게  80px",	IDM_DB_THUMB_ULTRALIGHT
			MENUITEM "보통 128px",	IDM_DB_THUMB_REGULAR
			MENUITEM "크게 160px",	IDM_DB_THUMB_DEMIBOLD
			MENUITEM "매우 크게 192px",	IDM_DB_THUMB_ULTRABOLD
		END
        MENUITEM "모든 내용 내보내기(&E)",	IDM_DRAUGHT_EXPORT
        MENUITEM "드래프트 보드 닫기(&Q)",	IDM_DRAUGHT_CLOSE
    END
END


