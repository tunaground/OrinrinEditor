/////////////////////////////////////////////////////////////////////////////
//
//	아이콘
//

//	애플리케이션의 아이콘을 모든 시스템에서 유지하기 위해, 가장 작은
//	ID 값의 아이콘이 처음에 배치됩니다.

IDI_ORINRINCOLLECTOR		ICON	"OrinrinCollector.ico"
IDI_SMALL	ICON	"OrinrinCollector.ico"

/////////////////////////////////////////////////////////////////////////////
//
//	메뉴
//

IDC_ORINRINCOLLECTOR MENU
BEGIN
    POPUP "팝업 메뉴"
    BEGIN
        MENUITEM "설정(&O)",					IDM_CLIPSTEAL_OPTION
        MENUITEM "복사 내용을 가져오기(&C)",	IDM_CLIPSTEAL_TOGGLE
        MENUITEM SEPARATOR
        MENUITEM "프로그램 종료(&Q)",			IDM_EXIT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
//	다이얼로그
//


/////////////////////////////////////////////////////////////////////////////
//
//	버전 정보
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2012,510,2200,920
 PRODUCTVERSION 1,2,0,920
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "Comments", "일본어 전용, 완전 무보증"
            VALUE "CompanyName", "나는 2ch, 야루오, 그리고 동방프로젝트를 사랑합니다"
            VALUE "LegalCopyright", "Copyright (C) 2011 - 2012 Orinrin/SikigamiHNQ"
            VALUE "LegalTrademarks", "라이선스 : GPLv3"
            VALUE "PrivateBuild", "Visual C++ 2008 Express로 빌드"
            VALUE "SpecialBuild", "특별하지 않음"
            VALUE "FileVersion", "2012.510.2200.920"
            VALUE "ProductVersion", "1.2.0.920"
            VALUE "FileDescription", "AsciiArt 수집기"
            VALUE "OriginalFilename", "OrinrinCollector.exe"
            VALUE "InternalName", "Orinrin 수집기"
            VALUE "ProductName", "Orinrin 수집기"
        END
    END
END



